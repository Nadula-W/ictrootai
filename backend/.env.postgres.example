# Copy into backend/.env, replacing the password and host from your Supabase Connect dialog.
# Use a dedicated backend DB role in production. Do not expose this URL to the browser.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
ENVIRONMENT=development
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
EMBEDDING_MODEL=embeddinggemma
OLLAMA_TIMEOUT=120
SECURE_COOKIES=false
