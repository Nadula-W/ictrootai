# Copy to backend/.env. Paste the connection string from Supabase > Connect > Session pooler.
# Keep private database credentials in this backend file only. Remote TLS is required.
# Application storage is PostgreSQL only; there is no SQLite fallback.
DATABASE_URL=
# direct uses PostgreSQL TCP. supabase_websocket wraps the same PG/TLS connection
# in Supabase's verified /v2 WSS transport on port 443 for restricted networks.
DATABASE_TRANSPORT=direct
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE=1800
ENVIRONMENT=development
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
EMBEDDING_MODEL=embeddinggemma
OLLAMA_TIMEOUT=120
SECURE_COOKIES=false
